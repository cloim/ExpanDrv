  "windows": ["main"],
  "permissions": [
    "allow-agent-status",
    "allow-mount-drive",
    "allow-mount-all",
    "allow-unmount-drive",
    "allow-get-drive",
    "allow-add-drive",
    "allow-update-drive",
    "allow-set-drive-secret",
    "allow-delete-drive",
    "allow-test-connection",
    "allow-check-drive",
    "allow-free-drive-letters",
    "allow-get-settings",
    "allow-set-autostart",
    "allow-stop-agent"
